target/
__pycache__/
*.egg-info/
dist/
*.so
*.dylib
*.pyd
.venv/
.claude/
.ipynb_checkpoints/

# Notebook run artefacts (kept out of git on purpose)
notebooks/data/*.png
notebooks/data/numerical_expression_tree
notebooks/data/wids_expression_tree
notebooks/data/heart_cleveland.csv
notebooks/v1.0.4_*.md
notebooks/data/equations/
!notebooks/data/equations/feynman/      # but keep the vendored Feynman CSVs
notebooks/data/figures/
notebooks/sweep.log
notebooks/circle_test.log

# Scratch scripts, logs, ledgers, sweep outputs — kept local, never committed
*.log
# Ignore by PURPOSE, not by prefix. The leading underscore does not mean
# "scratch" here: _denoise_op is imported by 11 files, _sympy_to_karva and
# _gene_decompose by 6 each. A blanket notebooks/_*.py silently excluded every
# NEW module (it only bites files not already tracked), which is how
# _bounded_simplify.py first shipped untracked.
notebooks/_tmp_*.py
notebooks/_tmp_*.sh
notebooks/*.sh
notebooks/_ledgers/
notebooks/_sweep_logs/
notebooks/_audit_*/
data/

# Notebook render artefacts (jupytext pairs + rendered output dirs)
notebooks/*_files/
notebooks/SphericalSymbolicRegression-run*.md
notebooks/SphericalSymbolicRegression-run*.py
notebooks/SphericalSymbolicRegression-run*.ipynb

# sr_logs: keep the results, manifest, scoreboard and progress log in git —
# they are small JSON and the record of how the challenge is going. The raw
# per-batch stdout and the sympy corpus are bulky and regenerable.
notebooks/sr_logs/batches/
notebooks/sr_logs/simplify_corpus.jsonl
notebooks/sr_logs/.staging_*/
